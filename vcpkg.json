{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "hotspot",
  "version": "1.5.80",
  "description": "The Linux perf GUI for performance analysis",
  "dependencies": [
    "ecm",
    {
      "name": "kddockwidgets",
      "features": [
        "qtwidgets"
      ]
    },
    {
      "name": "kf6archive",
      "features": ["lzma"]
    },
    "kf6configwidgets",
    "kf6coreaddons",
    "kf6i18n",
    "kf6iconthemes",
    "kf6itemmodels",
    "kf6itemviews",
    "kf6kio",
    "kf6notifications",
    "kf6parts",
    "kf6solid",
    "kf6syntaxhighlighting",
    "kf6threadweaver",
    "kf6windowsystem"
  ]
}
